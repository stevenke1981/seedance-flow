# 第 2 階段正式 bridge 部署範例；請填入部署平台的環境變數，不要提交真實憑證。
SEEDANCE_API_BASE_URL=https://ark.example.com/api/v3
SEEDANCE_ALLOWED_ORIGINS=https://your-app.example
SEEDANCE_BIND_HOST=0.0.0.0
SEEDANCE_REQUIRE_ORIGIN=true
SEEDANCE_RATE_LIMIT_PER_MINUTE=60
SEEDANCE_REQUEST_TIMEOUT_MS=45000
# 只有在反向代理可信且已正確設定時才開啟。
SEEDANCE_TRUST_PROXY=false
